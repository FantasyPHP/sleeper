* text=auto eol=lf

*.md diff=markdown
*.php diff=php

# Keep the dist archive to what a consumer actually needs: src, the licence, the
# composer manifest and the docs that explain the thing. Everything below is
# development material that would otherwise land in every vendor/ directory.
/.backlog/ export-ignore
/.github/ export-ignore
/docs/ export-ignore
/examples/ export-ignore
/tests/ export-ignore

/.envrc export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.pre-commit-config.yaml export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/cliff.toml export-ignore
/composer.lock export-ignore
/deptrac.php export-ignore
/devenv.lock export-ignore
/devenv.nix export-ignore
/devenv.yaml export-ignore
/infection.json5 export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/rector.php export-ignore
/release.sh export-ignore
